{{- $map := dict
      "penguin" (dict "machine" "chromebook" "brew" false "target" "lite")
      "steve"   (dict "machine" "mint"       "brew" true  "target" "fullfat") -}}
{{- $m := index $map .chezmoi.hostname -}}
{{- if not $m -}}{{- $m = dict "machine" "unknown" "brew" false "target" "lite" -}}{{- end -}}
sourceDir = {{ .chezmoi.workingTree | default .chezmoi.sourceDir | quote }}

[data]
    machine = {{ $m.machine | quote }}
    brew = {{ $m.brew }}
    defaultTargetType = {{ $m.target | quote }}
