
# ---- module: shell plugins via antidote (https://getantidote.github.io/) ----
# Antidote can come from Homebrew or a standalone clone (~/.antidote, installed
# by scripts/install-extras.sh --with prompt). No Homebrew required.
_antidote=""
if [[ -f "$HOME/.antidote/antidote.zsh" ]]; then
    _antidote="$HOME/.antidote/antidote.zsh"
elif command -v brew >/dev/null 2>&1 && [[ -f "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh" ]]; then
    _antidote="$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh"
fi
if [[ -n "$_antidote" ]]; then
    source "$_antidote"
    antidote load
fi
unset _antidote
