#!/usr/bin/env bash
#
# Baseline package install (managed by chezmoi -- edit home/, never ~).
#
# Installs the packages listed in packages/common.txt + packages/debian.txt with
# apt. This is the non-interactive BASELINE. Optional stacks (gcloud, docker,
# mise runtimes, prompt tooling) are offered by scripts/install-extras.sh.
#
# run_onchange_: this only re-runs when the rendered script changes, and the
# package lists are embedded below, so editing either list re-triggers it.
{{ if ne .chezmoi.os "linux" -}}
# Non-Linux platform: packages are handled by Brewfile / bootstrap.sh.
exit 0
{{ else -}}
set -euo pipefail

log() { printf '==> %s\n' "$*"; }

read -r -d '' PKG_RAW <<'PKGEOF' || true
{{ include "../packages/common.txt" }}
{{ include "../packages/debian.txt" }}
PKGEOF

mapfile -t PKGS < <(
  printf '%s\n' "$PKG_RAW" \
    | sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//' \
    | grep -v '^$'
)

if ((${#PKGS[@]} == 0)); then
  log "no baseline packages listed"
  exit 0
fi

missing=()
for pkg in "${PKGS[@]}"; do
  dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done

if ((${#missing[@]} == 0)); then
  log "baseline packages already present"
  exit 0
fi

log "Installing ${#missing[@]} baseline package(s): ${missing[*]}"
sudo apt-get update -qq
sudo apt-get install -y -qq "${missing[@]}"
log "baseline packages installed"
{{ end -}}
